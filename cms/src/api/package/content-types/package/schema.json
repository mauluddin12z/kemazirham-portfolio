    "price": {
      "type": "string",
      "required": true
    },
    "priceNote": {
      "type": "string",
      "default": "per project"
    },
    "badge": {
      "type": "string"
    },
    "features": {
      "type": "text",
      "required": true
    },
    "color": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
